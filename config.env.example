# Projekt
PROJECT_SLUG=harness-project
AUTONOMY_LEVEL=2

# Modelle. Der Prompt liegt quoting-sicher in $PROMPT_FILE.
BUILDER_MODEL=
BUILDER_CMD='codex exec --sandbox workspace-write < "$PROMPT_FILE"'
BUILDER_HELP_CMD='codex exec --help'
BUILDER_REQUIRED_FLAGS='--sandbox'
BUILDER_SAFE_MODE_PATTERN='--sandbox[ =]workspace-write'
BUILDER_ENV_ALLOWLIST=

REVIEWER_MODEL=
REVIEWER_CMD='claude -p --permission-mode acceptEdits < "$PROMPT_FILE"'
REVIEWER_HELP_CMD='claude --help'
REVIEWER_REQUIRED_FLAGS='--permission-mode'
REVIEWER_SAFE_MODE_PATTERN='--permission-mode[ =]acceptEdits'
REVIEWER_ENV_ALLOWLIST=

# QA / Red Team. Bei leerem QA_CMD bleibt QA standardmäßig aus.
QA_MODEL=
QA_ENDPOINT=
QA_CMD=
QA_HELP_CMD=
QA_REQUIRED_FLAGS=
QA_SAFE_MODE_PATTERN=
QA_ENV_ALLOWLIST=
QA_ENABLED=
QA_REQUIRED_FROM=
QA_PROBE_STRICT=1
QA_PROBE_RETRIES=3
QA_PROBE_TIMEOUT=180
QA_PROBE_SLEEP=300

# Limits und Leiter
PHASE_TIMEOUT=3600
MAX_ROUNDS_PLAN=2
MAX_ROUNDS_REWORK=8
REBUILD_ROUND=4
ARBITER_EXTRA_ROUNDS=2
RETRY_MAX=2
RETRY_SLEEP=120
GATE_ERROR_RETRIES=2
MAX_MS_PER_RUN=
LADDER_ENABLED=
NOTIFY_ENABLED=
ROLE_GUARDS=on
# ROLE_GUARDS=off ist der einzige bewusste Abschalter; PREFLIGHT protokolliert
# ihn laut und summary.json trägt role_guards="off".

# Projektkommandos. Gates greifen nur auf konfigurierte Kommandos zu.
PKG=
DEV_CMD=
BUILD_CMD=
TEST_CMD=
DEPS_CMD=
LINT_CMD=
SMOKE_CMD=
GRAPH_CMD=
API_CMD=
TRACE_CMD=
BENCH_CMD=
E2E_CMD=
SHOTS_CMD=
ASSETS_CMD=
ASSETS_BUILD_CMD=
RESEARCH_CMD=
MUT_CMD=
BOOTSTRAP_AUTO=0

# Text-/Daten-Preset-Gates
TEXT_LENGTH_ANCHOR=
STYLE_LINT_CMD=
CONTINUITY_CMD=
ZITATE_CMD=
SCHEMA_CMD=
REPRO_CMD=
GOLDEN_CMD=
# Optional pro Gate: Rückgabecodes, die statt fail als Infrastruktur gelten.
GATE_ERROR_CODES='126 127'
GOLDEN_PATH_REGEX='^tests/golden/'
MUT_SCOPE_REGEX='^src/.*\.(ts|js|py)$'
MUT_REPORT=reports/mutation/mutation.json

# Optionale projektspezifische Builder-Territorien/Rebuild-Pfade.
BUILDER_EXTRA_PATHS_REGEX=
REBUILD_PATHS='src tools tests/unit tests/properties'

# Mutgate v2
MUT_SCORE_MIN=65
MUT_SCORE_FLOOR=50
MUT_RATCHET_TOL=2

# Betrieb
NOTIFY_URL=
NOTIFY_TOPIC=harness-project
PUSH_REMOTE=0

# MCP/Tunnel (bootstrap.sh setzt projektbezogene Werte)
REPO_PATH=
MCP_HOST=127.0.0.1
PORT=8765
MCP_PATH=/mcp
MCP_ENV_DIR=
MCP_PYTHON=
CLOUDFLARED_BIN=
TUNNEL_MODE=
TUNNEL_NAME=
TUNNEL_HOSTNAME=
# TUNNEL_TOKEN und API-Keys stehen ausschließlich in orchestrator/secrets.env.

# Watchdog: 30 Minuten
WATCHDOG_STALE_SECONDS=1800
