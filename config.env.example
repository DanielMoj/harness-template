# Projekt
PROJECT_SLUG=harness-project
AUTONOMY_LEVEL=2

# Modelle. Der Prompt liegt quoting-sicher in $PROMPT_FILE.
BUILDER_MODEL=
BUILDER_CMD='codex exec --sandbox workspace-write < "$PROMPT_FILE"'
BUILDER_HELP_CMD='codex exec --help'
BUILDER_REQUIRED_FLAGS='--sandbox'
BUILDER_SAFE_MODE_PATTERN='--sandbox[ =]workspace-write'
BUILDER_ENV_ALLOWLIST=

REVIEWER_MODEL=
REVIEWER_CMD='claude -p --permission-mode acceptEdits < "$PROMPT_FILE"'
REVIEWER_HELP_CMD='claude --help'
REVIEWER_REQUIRED_FLAGS='--permission-mode'
REVIEWER_SAFE_MODE_PATTERN='--permission-mode[ =]acceptEdits'
REVIEWER_ENV_ALLOWLIST=

# QA / Red Team. Bei leerem QA_CMD bleibt QA standardmäßig aus.
QA_MODEL=
QA_ENDPOINT=
QA_CMD=
QA_HELP_CMD=
QA_REQUIRED_FLAGS=
QA_SAFE_MODE_PATTERN=
QA_ENV_ALLOWLIST=
QA_ENABLED=
QA_REQUIRED_FROM=
QA_PROBE_STRICT=1
QA_PROBE_RETRIES=3
QA_PROBE_TIMEOUT=180
QA_PROBE_SLEEP=300

# --- Beispiel: drei Anbieter, geprüft am 23.10.2026 -----------------------------------
# Flags belegt mit `codex exec --help` (Codex CLI 0.164.0), `claude --help` (Claude Code
# 2.1.309), `gemini --help` (Gemini CLI 0.65.0) und `qwen --help` (Qwen Code 0.26.0).
# Übernehmen: Zeilen ohne "# " einsetzen; sie ersetzen die gleichnamigen Werte oben.
# Jede CLI muss unter HOME angemeldet sein: Rollen laufen mit env -i, Schlüssel aus
# Umgebungsvariablen kommen nicht an. Unter WSL2/Linux braucht Codex bubblewrap (bwrap),
# die Gemini CLI ripgrep. Einzelheiten: README Abschnitt 6 und RUNBOOK.
#
# Builder: GPT-6 Astra über Codex CLI, höchste Effort-Stufe (ultra delegiert automatisch
# an Unteragenten und wird nicht verwendet). Den Modellkatalog zeigt `codex debug models`
# (`codex models` gibt es in 0.164.0 nicht); ob das Konto gpt-6-astra nutzen darf, belegt
# nur ein echter Aufruf. Ein -c-Wert, der kein gültiges TOML ist, gilt als Rohstring
# (max -> "max"). Im Modus workspace-write hat der Builder kein Netz; Abhängigkeiten
# installiert das deps-Gate vorab.
# BUILDER_MODEL=gpt-6-astra
# BUILDER_CMD='codex exec -m gpt-6-astra -c model_reasoning_effort=max --sandbox workspace-write < "$PROMPT_FILE"'
# BUILDER_HELP_CMD='codex exec --help'
# BUILDER_REQUIRED_FLAGS='--sandbox --model --config'
# BUILDER_SAFE_MODE_PATTERN='--sandbox[ =]workspace-write'
#
# Reviewer und Schiedsrichter (70-arbiter läuft über REVIEWER_CMD): Claude Opus 5.5 mit
# Effort max. Rscript für Anker und Gegenrechnungen; keine Sicherheitsgrenze, denn R
# startet über system() jedes Kommando (README Abschnitt 8). Markierte Anfragen kann
# Claude Code auf ein anderes Modell umleiten; Nachweis siehe RUNBOOK, Modellwechsel.
# REVIEWER_MODEL=claude-opus-5-5
# REVIEWER_CMD='claude -p --model claude-opus-5-5 --effort max --permission-mode acceptEdits --allowedTools "Bash(Rscript:*)" < "$PROMPT_FILE"'
# REVIEWER_HELP_CMD='claude --help'
# REVIEWER_REQUIRED_FLAGS='--permission-mode --model --effort --allowedTools'
# REVIEWER_SAFE_MODE_PATTERN='--permission-mode[ =]acceptEdits'
#
# QA Weg A (gewählt): Gemini 4 Argon über die Gemini CLI mit bezahltem API-Schlüssel in
# ~/.gemini/.env (GEMINI_API_KEY=...). Die CLI liest diese Datei nur in vertrauten Ordnern
# und stuft --approval-mode in nicht vertrauten Ordnern still auf default zurück; deshalb
# security.folderTrust.enabled=false in ~/.gemini/settings.json oder das Zielrepo in
# ~/.gemini/trustedFolders.json. Shell nur für Rscript über die Policy-Datei, nie yolo.
# QA_MODEL=gemini-4-argon
# QA_CMD='gemini -m gemini-4-argon --approval-mode auto_edit --policy orchestrator/policies/qa-gemini.toml < "$PROMPT_FILE"'
# QA_HELP_CMD='gemini --help'
# QA_REQUIRED_FLAGS='--approval-mode --policy --model'
# QA_SAFE_MODE_PATTERN='--approval-mode[ =]auto_edit'
# QA_ENABLED=1
#
# QA Weg C (Ersatz, falls die Argon-Probe ohne Terminal scheitert): Kimi K3 über Qwen Code
# und OpenRouter. In ~/.qwen/.env: OPENAI_API_KEY=..., OPENAI_BASE_URL=https://openrouter.ai/api/v1,
# OPENAI_MODEL=moonshotai/kimi-k3; die CLI liest diese Datei auch unter env -i. auto-edit
# schreibt sich mit Bindestrich; ohne --approval-mode läuft Qwen Code im Klassifikator-Modus
# auto, den der Wächter sperrt.
# QA_MODEL=moonshotai/kimi-k3
# QA_CMD='qwen --auth-type openai -m moonshotai/kimi-k3 --approval-mode auto-edit --allowed-tools "run_shell_command(Rscript)" < "$PROMPT_FILE"'
# QA_HELP_CMD='qwen --help'
# QA_REQUIRED_FLAGS='--approval-mode --allowed-tools --auth-type --model'
# QA_SAFE_MODE_PATTERN='--approval-mode[ =]auto-edit'
# QA_ENABLED=1
#
# Weg B (Antigravity CLI, agy) ist bewusst nicht konfiguriert (RUNBOOK, QA-Zugang). Läuft
# keiner der Wege, bleibt QA_ENABLED=0; dann fehlt QA, und kein anderes Modell wird
# stillschweigend eingetragen.
# -------------------------------------------------------------------------------------

# Limits und Leiter
PHASE_TIMEOUT=3600
MAX_ROUNDS_PLAN=2
MAX_ROUNDS_REWORK=8
REBUILD_ROUND=4
ARBITER_EXTRA_ROUNDS=2
RETRY_MAX=2
RETRY_SLEEP=120
GATE_ERROR_RETRIES=2
MAX_MS_PER_RUN=
LADDER_ENABLED=
NOTIFY_ENABLED=
ROLE_GUARDS=on
# ROLE_GUARDS=off ist der einzige bewusste Abschalter; PREFLIGHT protokolliert
# ihn laut und summary.json trägt role_guards="off".

# Projektkommandos. Gates greifen nur auf konfigurierte Kommandos zu.
PKG=
DEV_CMD=
BUILD_CMD=
TEST_CMD=
DEPS_CMD=
LINT_CMD=
SMOKE_CMD=
GRAPH_CMD=
API_CMD=
TRACE_CMD=
BENCH_CMD=
E2E_CMD=
SHOTS_CMD=
ASSETS_CMD=
ASSETS_BUILD_CMD=
RESEARCH_CMD=
MUT_CMD=
BOOTSTRAP_AUTO=0

# Text-/Daten-Preset-Gates
TEXT_LENGTH_ANCHOR=
STYLE_LINT_CMD=
CONTINUITY_CMD=
ZITATE_CMD=
SCHEMA_CMD=
REPRO_CMD=
GOLDEN_CMD=
# Optional pro Gate: Rückgabecodes, die statt fail als Infrastruktur gelten.
GATE_ERROR_CODES='126 127'
GOLDEN_PATH_REGEX='^tests/golden/'
MUT_SCOPE_REGEX='^src/.*\.(ts|js|py)$'
MUT_REPORT=reports/mutation/mutation.json

# Optionale projektspezifische Rollen-Territorien/Rebuild-Pfade.
BUILDER_EXTRA_PATHS_REGEX=
REVIEWER_EXTRA_PATHS_REGEX=
QA_EXTRA_PATHS_REGEX=
REBUILD_PATHS='src tools tests/unit tests/properties'

# Mutgate v2
MUT_SCORE_MIN=65
MUT_SCORE_FLOOR=50
MUT_RATCHET_TOL=2

# Betrieb
NOTIFY_URL=
NOTIFY_TOPIC=harness-project
PUSH_REMOTE=0

# MCP/Tunnel (bootstrap.sh setzt projektbezogene Werte)
REPO_PATH=
MCP_HOST=127.0.0.1
PORT=8765
MCP_PATH=/mcp
MCP_ENV_DIR=
MCP_PYTHON=
CLOUDFLARED_BIN=
TUNNEL_MODE=
TUNNEL_NAME=
TUNNEL_HOSTNAME=
# TUNNEL_TOKEN und API-Keys stehen ausschließlich in orchestrator/secrets.env.

# Watchdog: 30 Minuten
WATCHDOG_STALE_SECONDS=1800
