PROJECT_SLUG=acceptance-t2
AUTONOMY_LEVEL=3
ACCEPTANCE_SCENARIO=T2
ACCEPTANCE_TRANSPORT_PROBE=1
ACCEPTANCE_TERRITORY_PROBE=1

BUILDER_MODEL=fake-builder
BUILDER_CMD='bash tests/template/fake-model.sh builder'
BUILDER_HELP_CMD='bash tests/template/fake-model.sh --help'
BUILDER_REQUIRED_FLAGS=
BUILDER_SAFE_MODE_PATTERN=

REVIEWER_MODEL=fake-reviewer
REVIEWER_CMD='bash tests/template/fake-model.sh reviewer'
REVIEWER_HELP_CMD='bash tests/template/fake-model.sh --help'
REVIEWER_REQUIRED_FLAGS=
REVIEWER_SAFE_MODE_PATTERN=

QA_ENABLED=0
QA_REQUIRED_FROM=M99
PHASE_TIMEOUT=30
MAX_ROUNDS_PLAN=2
MAX_ROUNDS_REWORK=4
REBUILD_ROUND=4
ARBITER_EXTRA_ROUNDS=2
RETRY_MAX=1
RETRY_SLEEP=0
MAX_MS_PER_RUN=2
LADDER_ENABLED=1

NOTIFY_ENABLED=1
NOTIFY_URL=https://notify.invalid/acceptance
NOTIFY_TOPIC=acceptance-t2
PUSH_REMOTE=0
BOOTSTRAP_AUTO=0
